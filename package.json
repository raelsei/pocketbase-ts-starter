{
	"name": "pocketbase-ts-starter",
	"private": true,
	"type": "module",
	"description": "PocketBase + TypeScript hooks/migrations, packaged with Docker.",
	"scripts": {
		"build": "bun scripts/build.ts",
		"watch": "bun scripts/build.ts --watch",
		"check": "biome check . && tsc --noEmit",
		"fix": "biome check --write .",
		"bench": "bun scripts/bench.ts",
		"up": "docker compose up -d --build",
		"down": "docker compose down",
		"logs": "docker compose logs -f pocketbase",
		"test:smoke": "bun scripts/smoke.ts",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.3"
}

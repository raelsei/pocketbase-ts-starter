# 32 hex chars: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Superuser auto-created on first boot
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Superuser IP allowlist — space-separated list of IPs/subnets.
# FILL THIS IN production: even with a stolen token, requests from IPs
# outside the list get 403.
# Example: PB_SUPERUSER_IPS=127.0.0.1 10.0.0.5
# https://pocketbase.io/docs/going-to-production/#restrict-superusers-to-specific-ipssubnets
PB_SUPERUSER_IPS=

# 32 karakter hex: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# İlk boot'ta otomatik oluşturulan superuser
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Superuser IP allowlist — boşlukla ayrılmış IP/subnet listesi.
# Production'da DOLDUR: token çalınsa bile listedeki IP'ler dışından 403 döner.
# Örn: PB_SUPERUSER_IPS=127.0.0.1 10.0.0.5
# https://pocketbase.io/docs/going-to-production/#restrict-superusers-to-specific-ipssubnets
PB_SUPERUSER_IPS=
